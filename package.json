{
  "name": "prettier-plugin-minimal-diff",
  "version": "0.1.0",
  "private": true,
  "description": "Prettier plugin that adds options for output with smaller diffs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shokkunrf/prettier-plugin-minimal-diff.git"
  },
  "type": "module",
  "exports": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "npm run build && npm run test:run",
    "test:run": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
